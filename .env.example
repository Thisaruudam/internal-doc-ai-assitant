# Copy to .env and fill in. Never commit the filled copy.
#
#   cp .env.example .env
#
# Every value below maps to a field in app/config.py. Nested settings use the
# group's env_prefix (GEMINI_, PINECONE_, SECURITY_, ...), not a delimiter.

# ── Required ──────────────────────────────────────────────────────────────
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# https://app.pinecone.io  (serverless free tier is sufficient)
PINECONE_API_KEY=

# ── Observability — mandatory per the assessment brief ────────────────────
# https://smith.langchain.com  → Settings → API Keys
OBSERVABILITY_LANGSMITH_API_KEY=
OBSERVABILITY_LANGSMITH_PROJECT=atrium
OBSERVABILITY_LANGSMITH_TRACING=true

# ── Environment ───────────────────────────────────────────────────────────
ENVIRONMENT=dev
ORGANIZATION_NAME=Commercial Bank

# ── Security ──────────────────────────────────────────────────────────────
# Leave unset in dev. Outside dev the app refuses to start unless this is set
# to at least 32 bytes. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# SECURITY_JWT_SECRET=
SECURITY_JWT_TTL_MINUTES=60

# ── Model routing (defaults are sensible; override to experiment) ─────────
# GEMINI_MODEL_FAST=gemini-3.5-flash-lite
# GEMINI_MODEL_AGENT=gemini-3.5-flash
# GEMINI_MODEL_RESPONSE=gemini-3.6-flash
# GEMINI_MODEL_DEEP=gemini-3.1-pro-preview
# GEMINI_EMBEDDING_DIMENSIONS=1536

# ── Retrieval tuning ──────────────────────────────────────────────────────
# 1.0 = pure dense, 0.0 = pure sparse.
# PINECONE_HYBRID_ALPHA=0.5
# PINECONE_TOP_K_FINAL=8

# ── Local services ────────────────────────────────────────────────────────
# Defaults target docker compose. Change the hosts to localhost when running
# the API outside the compose network.
POSTGRES_DSN=postgresql://atrium:atrium@postgres:5432/atrium
REDIS_URL=redis://redis:6379/0
MCP_SERVER_URL=http://mcp:8900/mcp
API_BASE_URL=http://localhost:8000
